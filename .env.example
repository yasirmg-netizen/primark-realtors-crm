# Copy this file to .env only for local testing on your own computer.
# On Render, you'll enter these one at a time as "Environment Variables" in
# the dashboard instead - never put real secrets in a file you might share.

JWT_SECRET=replace-with-a-long-random-string
SUPER_ADMIN_USERNAME=Prim001
SUPER_ADMIN_PASSWORD=choose-a-strong-password-then-change-it-after-first-login

# From your Turso database (turso.tech) - see README for how to get these.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

PORT=3000

# ---- Optional: marketing platform integrations (set up when you're ready) ----

# Generic webhook (Zapier, Make, form builders, etc.) - make up any long
# random string here, then use it in the webhook URL you configure on that
# platform: https://your-app-url/api/webhooks/inbound?token=THIS_VALUE
WEBHOOK_SECRET=

# Native Instagram/Facebook Lead Ads (Meta). See README for setup steps.
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
